class Solution {
    public ListNode mergeNodes(ListNode head) {
        ListNode result=head;
        ListNode current=head.next;
        int sum=0;
        while(current!=null){
            if(current.val!=0){
                sum+=current.val;
            }
            else{
                result.val=sum;
                sum=0;
                if(current.next!=null){
                   result.next=current;
                   result=current;

                }
                else{
                    result.next=null;
                }
            }
            current=current.next;
        }
        return head;
        
    }
}
